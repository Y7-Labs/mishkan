{
  "$defs": {
    "CollaborationEdge": {
      "additionalProperties": false,
      "properties": {
        "artifact_contracts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Contracts",
          "type": "array"
        },
        "interaction": {
          "$ref": "#/$defs/CollaborationInteraction"
        },
        "purpose": {
          "maxLength": 4096,
          "minLength": 3,
          "title": "Purpose",
          "type": "string"
        },
        "source_identity": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Source Identity",
          "type": "string"
        },
        "target_identity": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Target Identity",
          "type": "string"
        }
      },
      "required": [
        "source_identity",
        "target_identity",
        "interaction",
        "purpose"
      ],
      "title": "CollaborationEdge",
      "type": "object"
    },
    "CollaborationInteraction": {
      "enum": [
        "delegate",
        "collaborate",
        "consult",
        "handoff",
        "challenge",
        "evaluate"
      ],
      "title": "CollaborationInteraction",
      "type": "string"
    },
    "CrewAICollaborationProposal": {
      "additionalProperties": false,
      "description": "Attributable CrewAI proposal; MISHKAN still validates and authorizes it.",
      "properties": {
        "alternatives": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        },
        "collaboration_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Collaboration Reasons",
          "type": "array"
        },
        "interactions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CollaborationEdge"
          },
          "title": "Interactions",
          "type": "array"
        },
        "production_owner_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Production Owner Ids",
          "type": "array"
        },
        "production_shape": {
          "$ref": "#/$defs/ProductionShape"
        }
      },
      "required": [
        "production_shape",
        "production_owner_ids",
        "alternatives"
      ],
      "title": "CrewAICollaborationProposal",
      "type": "object"
    },
    "CrewAssignmentKind": {
      "enum": [
        "production",
        "contributor",
        "evaluation",
        "reporting",
        "audit"
      ],
      "title": "CrewAssignmentKind",
      "type": "string"
    },
    "CrewSelectionEvidence": {
      "additionalProperties": false,
      "properties": {
        "availability_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Availability References",
          "type": "array"
        },
        "competence_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Competence References",
          "type": "array"
        },
        "conflict_assessment": {
          "maxLength": 2048,
          "minLength": 3,
          "title": "Conflict Assessment",
          "type": "string"
        },
        "independence_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Independence References",
          "type": "array"
        },
        "project_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Project References",
          "type": "array"
        },
        "risk_coverage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Risk Coverage",
          "type": "array"
        }
      },
      "required": [
        "project_references",
        "competence_references",
        "availability_references",
        "conflict_assessment",
        "risk_coverage",
        "independence_references"
      ],
      "title": "CrewSelectionEvidence",
      "type": "object"
    },
    "EscalationOption": {
      "additionalProperties": false,
      "properties": {
        "consequences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Consequences",
          "type": "array"
        },
        "description": {
          "maxLength": 4096,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "option_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Risks",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "description",
        "consequences",
        "risks"
      ],
      "title": "EscalationOption",
      "type": "object"
    },
    "MissionCrewMember": {
      "additionalProperties": false,
      "properties": {
        "assignment_kind": {
          "$ref": "#/$defs/CrewAssignmentKind"
        },
        "identity_id": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Identity Id",
          "type": "string"
        },
        "responsibility": {
          "maxLength": 2048,
          "minLength": 3,
          "title": "Responsibility",
          "type": "string"
        },
        "selection_evidence": {
          "$ref": "#/$defs/CrewSelectionEvidence"
        }
      },
      "required": [
        "identity_id",
        "assignment_kind",
        "responsibility",
        "selection_evidence"
      ],
      "title": "MissionCrewMember",
      "type": "object"
    },
    "ProductionShape": {
      "enum": [
        "single_owner",
        "consultative",
        "multi_producer"
      ],
      "title": "ProductionShape",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EscalationOption"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "approved_collaboration": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrewAICollaborationProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approved_members": {
      "items": {
        "$ref": "#/$defs/MissionCrewMember"
      },
      "minItems": 2,
      "title": "Approved Members",
      "type": "array"
    },
    "coverage": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "cto_recommended_option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cto Recommended Option Id"
    },
    "disposition": {
      "enum": [
        "confirmed",
        "rejected"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "disputed_scope": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Disputed Scope",
      "type": "array"
    },
    "evidence_references": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence References",
      "type": "array"
    },
    "independent_work_continuing": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Independent Work Continuing",
      "type": "array"
    },
    "mission_lead_id": {
      "maxLength": 128,
      "minLength": 2,
      "title": "Mission Lead Id",
      "type": "string"
    },
    "pm_recommended_option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pm Recommended Option Id"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 3,
      "title": "Rationale",
      "type": "string"
    },
    "unresolved_findings": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Findings",
      "type": "array"
    }
  },
  "required": [
    "disposition",
    "rationale",
    "evidence_references",
    "coverage",
    "mission_lead_id",
    "approved_members",
    "unresolved_findings"
  ],
  "title": "CTOMissionReview",
  "type": "object"
}
