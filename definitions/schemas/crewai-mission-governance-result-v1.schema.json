          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/MissionOrigin"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/MissionState",
          "default": "proposed"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "organization_id",
        "organization_version"
      ],
      "title": "MissionRecord",
      "type": "object"
    },
    "MissionState": {
      "enum": [
        "proposed",
        "clarifying",
        "planned",
        "active",
        "paused",
        "blocked",
        "evaluating",
        "remediating",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "MissionState",
      "type": "string"
    },
    "MissionTemplateReference": {
      "additionalProperties": false,
      "description": "Exact immutable identity of optional mission guidance used by a plan.",
      "properties": {
        "catalogue_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Catalogue Id",
          "type": "string"
        },
        "catalogue_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Catalogue Revision",
          "type": "string"
        },
        "definition_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Fingerprint",
          "type": "string"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "template_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Template Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "version",
        "source",
        "provenance",
        "catalogue_id",
        "catalogue_revision",
        "definition_fingerprint"
      ],
      "title": "MissionTemplateReference",
      "type": "object"
    },
    "ProductionShape": {
      "enum": [
        "single_owner",
        "consultative",
        "multi_producer"
      ],
      "title": "ProductionShape",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brief": {
      "$ref": "#/$defs/MissionBrief"
    },
    "collaboration": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrewAICollaborationProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "crew": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissionCrewRevision"
        },
        {
          "type": "null"
        }
      ]
    },
    "disagreement": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissionGovernanceDisagreement"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "disposition": {
      "default": "agreed",
      "enum": [
        "agreed",
        "disagreement"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/CrewAIGovernanceLineage"
    },
    "mission": {
      "$ref": "#/$defs/MissionRecord"
    }
  },
  "required": [
    "mission",
    "brief",
    "crew",
    "lineage"
  ],
  "title": "MissionGovernanceResult",
  "type": "object"
}
