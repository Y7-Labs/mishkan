{
  "$defs": {
    "KnowledgeClass": {
      "enum": [
        "literal",
        "episodic",
        "semantic",
        "structural"
      ],
      "title": "KnowledgeClass",
      "type": "string"
    },
    "KnowledgeScope": {
      "additionalProperties": false,
      "description": "Exact execution and organizational scope for one knowledge request.",
      "properties": {
        "agent_identity": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Identity"
        },
        "context_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Context Revision",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mission Id"
        },
        "project_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Id"
        },
        "repository_revision": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Revision"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "project_id",
        "context_revision"
      ],
      "title": "KnowledgeScope",
      "type": "object"
    },
    "KnowledgeStaleness": {
      "enum": [
        "current",
        "stale",
        "not_applicable",
        "unknown"
      ],
      "title": "KnowledgeStaleness",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "content_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "content_reference": {
      "pattern": "^artifact:[0-9a-f-]{36}$",
      "title": "Content Reference",
      "type": "string"
    },
    "content_transformed": {
      "default": false,
      "title": "Content Transformed",
      "type": "boolean"
    },
    "external_record_id": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Record Id"
    },
    "inspection_findings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Inspection Findings",
      "type": "array"
    },
    "item_id": {
      "format": "uuid",
      "title": "Item Id",
      "type": "string"
    },
    "knowledge_class": {
      "$ref": "#/$defs/KnowledgeClass"
    },
    "media_type": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "ranking_basis": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Ranking Basis",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/KnowledgeScope"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_locator": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source Locator",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Revision"
    },
    "staleness": {
      "$ref": "#/$defs/KnowledgeStaleness"
    },
    "staleness_reason": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Staleness Reason"
    },
    "trust": {
      "const": "untrusted_evidence",
      "default": "untrusted_evidence",
      "title": "Trust",
      "type": "string"
    }
  },
  "required": [
    "knowledge_class",
    "source_id",
    "scope",
    "content_reference",
    "content_digest",
    "media_type",
    "source_locator",
    "staleness",
    "ranking_basis",
    "rank"
  ],
  "title": "KnowledgeItem",
  "type": "object"
}
