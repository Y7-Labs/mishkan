{
  "$defs": {
    "EffectReportState": {
      "enum": [
        "not_applicable",
        "proven",
        "uncertain"
      ],
      "title": "EffectReportState",
      "type": "string"
    },
    "WorkerCompletionState": {
      "enum": [
        "delivered",
        "accepted",
        "rejected",
        "duplicate",
        "stale"
      ],
      "title": "WorkerCompletionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted At"
    },
    "artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "effect_evidence_artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Effect Evidence Artifact Ids",
      "type": "array"
    },
    "effect_report": {
      "$ref": "#/$defs/EffectReportState"
    },
    "envelope_id": {
      "format": "uuid",
      "title": "Envelope Id",
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/WorkerCompletionState"
    },
    "unified_patch_artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unified Patch Artifact Id"
    },
    "worker_id": {
      "format": "uuid",
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "envelope_id",
    "lease_id",
    "worker_id",
    "fingerprint",
    "state",
    "result",
    "effect_report",
    "received_at"
  ],
  "title": "WorkerCompletion",
  "type": "object"
}
