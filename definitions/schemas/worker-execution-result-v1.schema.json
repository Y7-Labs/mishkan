{
  "$defs": {
    "EffectReportState": {
      "enum": [
        "not_applicable",
        "proven",
        "uncertain"
      ],
      "title": "EffectReportState",
      "type": "string"
    },
    "WorkerArtifactKind": {
      "enum": [
        "output",
        "unified_patch",
        "effect_evidence"
      ],
      "title": "WorkerArtifactKind",
      "type": "string"
    },
    "WorkerGeneratedArtifact": {
      "additionalProperties": false,
      "description": "Lease-local bytes awaiting upload; the coordinator assigns the artifact identity.",
      "properties": {
        "content_base64": {
          "maxLength": 1431655768,
          "minLength": 1,
          "title": "Content Base64",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkerArtifactKind",
          "default": "output"
        },
        "media_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Name",
          "type": "string"
        },
        "retention": {
          "default": "run",
          "maxLength": 64,
          "minLength": 1,
          "title": "Retention",
          "type": "string"
        },
        "sensitivity": {
          "default": "internal",
          "maxLength": 64,
          "minLength": 1,
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "name",
        "media_type",
        "content_base64"
      ],
      "title": "WorkerGeneratedArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Executor-produced material; mishkand still validates and accepts it separately.",
  "properties": {
    "artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "effect_evidence_artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Effect Evidence Artifact Ids",
      "type": "array"
    },
    "effect_report": {
      "$ref": "#/$defs/EffectReportState",
      "default": "not_applicable"
    },
    "generated_artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkerGeneratedArtifact"
      },
      "title": "Generated Artifacts",
      "type": "array"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "unified_patch_artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unified Patch Artifact Id"
    }
  },
  "required": [
    "result"
  ],
  "title": "WorkerExecutionResult",
  "type": "object"
}
