{
  "$defs": {
    "RemotePlacementState": {
      "enum": [
        "queued",
        "leased",
        "completed",
        "cancelled"
      ],
      "title": "RemotePlacementState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "envelope_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Envelope Id"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_worker_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Worker Id"
    },
    "state": {
      "$ref": "#/$defs/RemotePlacementState"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_row_id": {
      "format": "uuid",
      "title": "Task Row Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_row_id",
    "task_id",
    "state",
    "request_fingerprint",
    "revision",
    "updated_at"
  ],
  "title": "RemotePlacement",
  "type": "object"
}
