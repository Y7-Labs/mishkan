{
  "$defs": {
    "CapabilityObservation": {
      "additionalProperties": false,
      "description": "One worker-observed capability; observation never grants authority.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Attributes",
          "type": "object"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version",
        "fingerprint"
      ],
      "title": "CapabilityObservation",
      "type": "object"
    },
    "WorkerAvailability": {
      "enum": [
        "never_seen",
        "online",
        "stale",
        "revoked"
      ],
      "title": "WorkerAvailability",
      "type": "string"
    },
    "WorkerHeartbeatRecord": {
      "additionalProperties": false,
      "properties": {
        "active_lease_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Active Lease Ids",
          "type": "array"
        },
        "advertisement_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Advertisement Fingerprint",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/WorkerAvailability"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityObservation"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/WorkerResourceSnapshot"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "worker_id",
        "sequence",
        "advertisement_fingerprint",
        "capabilities",
        "resources",
        "observed_at",
        "expires_at",
        "availability"
      ],
      "title": "WorkerHeartbeatRecord",
      "type": "object"
    },
    "WorkerIdentity": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "current_certificate_serial": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Certificate Serial"
        },
        "display_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/WorkerState"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "display_name",
        "state",
        "revision",
        "updated_at"
      ],
      "title": "WorkerIdentity",
      "type": "object"
    },
    "WorkerResourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "active_tasks": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Active Tasks",
          "type": "integer"
        },
        "architecture": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "available_memory_bytes": {
          "minimum": 1,
          "title": "Available Memory Bytes",
          "type": "integer"
        },
        "logical_cpu_count": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Logical Cpu Count",
          "type": "integer"
        },
        "max_concurrency": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "platform": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "architecture",
        "logical_cpu_count",
        "available_memory_bytes",
        "max_concurrency",
        "active_tasks"
      ],
      "title": "WorkerResourceSnapshot",
      "type": "object"
    },
    "WorkerState": {
      "enum": [
        "active",
        "revoked"
      ],
      "title": "WorkerState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bounded administrative projection; an observed capability grants no authority.",
  "properties": {
    "availability": {
      "$ref": "#/$defs/WorkerAvailability"
    },
    "heartbeat": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerHeartbeatRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identity": {
      "$ref": "#/$defs/WorkerIdentity"
    }
  },
  "required": [
    "identity",
    "availability"
  ],
  "title": "WorkerStatus",
  "type": "object"
}
